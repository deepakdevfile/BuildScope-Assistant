# Live AI model (leave empty in dev to use the free keyword-based demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set to 1 to allow the demo mock in production when no API key is configured
CHAT_MOCK=

